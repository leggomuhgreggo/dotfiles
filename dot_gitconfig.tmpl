[user]
	name = Greg Westneat
	email = "{{ .email }}"

[core]
	excludesfile = /Users/gregorywestneat/.gitignore_global
	editor = code --wait
	untrackedCache = true
	commitGraph = true
	multiPackIndex = true
[diff]
  tool = vscode
[difftool "vscode"]
  cmd = code --wait --diff $LOCAL $REMOTE
[merge]
  tool = vscode
[mergetool "vscode"]
  cmd = code --wait $MERGED

[rerere]
	enabled = true
	autoupdate = true

[alias]
	fetch-checkout = !sh -c 'git fetch $1 $2 && git checkout $2' -
	append = commit --amend --no-edit

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[rebase]
	autosquash = true
	autoStash = true

[fetch]
	prune = true
	negotiationAlgorithm = skipping
	writeCommitGraph = true

[gc]
	writeCommitGraph = true

[init]
	defaultBranch = main

[pull]
	rebase = true
